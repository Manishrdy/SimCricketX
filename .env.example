# -----------------------------------------------------------------------------
# Exception -> GitHub Issue Automation (optional)
# -----------------------------------------------------------------------------
# Enable automatic GitHub issue creation after exception rows are committed.
GITHUB_ISSUE_ON_EXCEPTION_ENABLED=false

# Fine-grained PAT recommended. Minimum permissions:
# - Issues: Read and write
# For public repositories, classic token with `public_repo` also works.
GITHUB_TOKEN=your_github_token_here

# Repository in owner/repo format (example: octocat/Hello-World)
GITHUB_REPOSITORY=owner/repository

# Optional issue customization
GITHUB_ISSUE_TITLE_PREFIX=[Auto Exception]
GITHUB_ISSUE_LABELS=bug,auto-exception
GITHUB_ISSUE_ASSIGNEES=

# -----------------------------------------------------------------------------
# GitHub Webhook (PLAN-IR-001 Phase 3)
# -----------------------------------------------------------------------------
# Shared secret for validating inbound GitHub webhook deliveries.
# Configure the same value in: GitHub repo -> Settings -> Webhooks ->
#   Payload URL: https://<your-host>/webhooks/github/issues
#   Content type: application/json
#   Secret: (this value)
#   Events: "Issues" only
# Leave blank to disable inbound webhook processing entirely.
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Auction UX rollout (Module A)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Identity policy (Modules 1–11; opt-in, defaults remain disabled)
# See docs/IDENTITY_LOCAL_TESTING.md before local acceptance testing.
# Generate separate random secrets of at least 32 bytes; never commit real keys.
# Keep the signup key stable: deletion/merge markers depend on it.
# -----------------------------------------------------------------------------
IDENTITY_DEVICE_KEY=
IDENTITY_DEVICE_PREVIOUS_KEY=
IDENTITY_DEVICE_PREVIOUS_UNTIL=
IDENTITY_SIGNUP_KEY=
IDENTITY_SIGNUP_ENFORCE=false
IDENTITY_NETWORK_ENFORCE=false
PROXYCHECK_API_KEY=
# Optional private directory, mode 0700. Omit to use the application default.
# IDENTITY_EMAIL_BACKUP_DIR=/absolute/private/path/identity-operation-backups
# Email links use email.app_url in config/config.yaml; set a local URL for local
# testing. SIMCRICKETX_TEST_MODE does not suppress outbound email/provider calls.
